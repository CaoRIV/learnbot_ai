# Chọn một provider: siliconflow | openai | gemini
LLM_PROVIDER=siliconflow

# SiliconFlow
SILICONFLOW_API_KEY=
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1/chat/completions
SILICONFLOW_MODEL_NAME=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B

# OpenAI
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL_NAME=gpt-4o-mini

# Gemini
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL_NAME=gemini-3.5-flash

# Tìm kiếm web tùy chọn
SERPAPI_KEY=

# Reranker: cross_encoder | llm
RERANK_METHOD=cross_encoder

# Model embedding và CrossEncoder dùng cho retrieval/reranking cục bộ
EMBED_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RERANK_MODEL_NAME=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Chỉ đưa bằng chứng cục bộ có điểm rerank từ ngưỡng này trở lên vào context (0-1)
MIN_RELEVANCE_SCORE=0.35

# Endpoint tải model; có thể đổi sang mirror nội bộ nếu cần
HF_ENDPOINT=https://huggingface.co

# Dung lượng tối đa cho mỗi tài liệu tải lên (MB)
MAX_UPLOAD_SIZE_MB=25

# SQLite local; đường dẫn tương đối được tính từ thư mục gốc dự án
DATABASE_PATH=data/learnbot.db

# Thư mục snapshot FAISS/BM25; đường dẫn tương đối tính từ thư mục gốc dự án
INDEX_DIRECTORY=data/indexes
