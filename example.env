# Chọn một provider: siliconflow | openai | gemini
LLM_PROVIDER=siliconflow

# SiliconFlow
SILICONFLOW_API_KEY=
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1/chat/completions
SILICONFLOW_MODEL_NAME=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B

# OpenAI
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL_NAME=gpt-4o-mini

# Gemini
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL_NAME=gemini-3.5-flash

# Tìm kiếm web tùy chọn
SERPAPI_KEY=

# Reranker: cross_encoder | llm
RERANK_METHOD=cross_encoder

# Dung lượng tối đa cho mỗi tài liệu tải lên (MB)
MAX_UPLOAD_SIZE_MB=25

# SQLite local; đường dẫn tương đối được tính từ thư mục gốc dự án
DATABASE_PATH=data/learnbot.db
